# ────────────────────────────────────────────────────────────────────────────
# Atlas Library — Environment Variables
#
# Copy apps/backend/.env.example → apps/backend/.env and fill in real values.
# Never commit .env files. See AGENT.md §14 — Security Requirements.
# ────────────────────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────────────────────

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port the backend server listens on
PORT=5000

# MongoDB connection URI
# Local development: ensure mongod is running first
MONGODB_URI=mongodb://localhost:27017/atlas_dev

# Allowed CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:5173

# ── Frontend ─────────────────────────────────────────────────────────────────
# Vite env vars must be prefixed with VITE_ to be exposed to the browser.
# Place these in apps/frontend/.env (also gitignored).

# Backend API base URL (used by frontend HTTP client)
VITE_API_BASE_URL=http://localhost:5000/api/v1
