# Atlas Library — Backend Environment Variables
#
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
# Runtime mode: development | test | production
NODE_ENV=development

# Port the Express server listens on
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
# Ensure mongod is running before starting the server.
# Windows service: check "MongoDB" in services.msc
# Manual start:    mongod --dbpath C:\data\db
MONGODB_URI=mongodb://localhost:27017/atlas_dev

# ── CORS ──────────────────────────────────────────────────────────────────────
# Allowed frontend origin (must match Vite dev server URL)
CORS_ORIGIN=http://localhost:5173

# ── Auth ───────────────────────────────────────────────────────────────────────
# Secret key used to sign JWT access tokens.
# Use a long random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-use-32-random-chars-in-production

# JWT expiry duration (jsonwebtoken format: "24h", "7d", "15m")
JWT_EXPIRES_IN=24h

# ── Super Admin Platform Credentials ──────────────────────────────────────────
# Required for bootstrapping platform super-admin securely without hardcoded credentials
SUPERADMIN_EMAIL=admin@yourdomain.com
SUPERADMIN_PASSWORD=your-secure-superadmin-password-min-8-chars
SUPERADMIN_NAME="Platform Super Admin"

# ── Rate Limiting (Security Hardening) ─────────────────────────────────────────
# Rate limit window in milliseconds (default: 900000 = 15 minutes)
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Max login attempts per IP per window
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
# Max password reset / OTP attempts per IP per window
PASSWORD_RESET_RATE_LIMIT_MAX=5
