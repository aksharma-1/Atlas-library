# Atlas Library — Backend Environment Variables
#
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
# Runtime mode: development | test | production
NODE_ENV=development

# Port the Express server listens on
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
# Ensure mongod is running before starting the server.
# Windows service: check "MongoDB" in services.msc
# Manual start:    mongod --dbpath C:\data\db
MONGODB_URI=mongodb://localhost:27017/atlas_dev

# ── CORS ──────────────────────────────────────────────────────────────────────
# Allowed frontend origin (must match Vite dev server URL)
CORS_ORIGIN=http://localhost:5173
